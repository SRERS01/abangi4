ser@user-Latitude-3380:~/.local/share/waydroid/data/app$ mkdir -p /home/user/Downloads/waydroid_extracted_apks
user@user-Latitude-3380:~/.local/share/waydroid/data/app$ find . -name "base.apk" | while read -r apk_path; do
    pkg_name=$(aapt dump badging "$apk_path" 2>/dev/null | grep "package: name=" | head -n 1 | awk -F"'" '{print $2}')
    if [ -z "$pkg_name" ]; then
        pkg_name=$(echo "$apk_path" | cut -d/ -f3 | cut -d- -f1)
    fi
    echo "Extracting: $pkg_name..."
    cp "$apk_path" /home/user/Downloads/waydroid_extracted_apks/"$pkg_name".apk
done

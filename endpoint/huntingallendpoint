## Dual-Focus Automation Script
Save this code block as hunt.sh. It automatically links both techniques by taking a domain, finding its cloud assets, filtering for APIs, and scanning for active endpoints.

#!/bin/bash
DOMAIN=$1

echo "[+] Starting Cloud Subdomain Discovery..."
subfinder -d $DOMAIN -silent > subs.txt

echo "[+] Filtering for Live Cloud Web Assets..."
cat subs.txt | httpx -silent -sc -title > live_assets.txt

echo "[+] Extracting API Endpoints from History..."
cat subs.txt | gau | grep -E "(/api/|/v1/|/v2/|/graphql)" > discovered_apis.txt

echo "[+] Fuzzing Live Assets for Hidden API Docs..."while read -r url; do
    ffuf -u "$url/FUZZ" -w /path/to/SecLists/Discovery/Web-Content/common.txt -mc 200,301 -silent >> fuzz_results.txtdone < <(cat subs.txt | httpx -silent)

echo "[+] Recon complete. Check live_assets.txt, discovered_apis.txt, and fuzz_results.txt"

